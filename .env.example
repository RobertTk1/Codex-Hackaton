# Magic Mirror environment contract
#
# Copy this file to .env.local for local development. Never commit real values.
# Browser-exposed variables must contain only public configuration.

# Application
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=3000

# Supabase: safe for the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase: server only; never use in Vite/browser code
SUPABASE_SERVICE_ROLE_KEY=

# Server-only provider credentials
OPENAI_API_KEY=
GEMINI_API_KEY=
DECART_API_KEY=
EMAIL_DELIVERY_API_KEY=

# Email delivery configuration
EMAIL_FROM_ADDRESS=

# Shopify Global Catalog uses a hosted UCP agent profile.
SHOPIFY_AGENT_PROFILE_URL=
