# Magic Mirror environment contract
#
# Copy this file to .env.local for local development. Never commit real values.
# Browser-exposed variables must contain only public configuration.

# Application
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=3000

# Supabase: safe for the browser
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase: server only; never use in Vite/browser code
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth local development only. Create a separate Google OAuth web client for development;
# never reuse or commit its secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Server-only provider credentials
OPENAI_API_KEY=
GEMINI_API_KEY=
DECART_API_KEY=
EMAIL_DELIVERY_API_KEY=

# Email delivery configuration
EMAIL_FROM_ADDRESS=

# Shopify Global Catalog uses a hosted UCP agent profile.
SHOPIFY_AGENT_PROFILE_URL=

# DigitalOcean development deployment only. Copy these names to the ignored
# .env.digitalocean.dev.local file; never point them at production Supabase.
DIGITALOCEAN_ACCESS_TOKEN=
MAGIC_MIRROR_DEV_API_IMAGE_DIGEST=
MAGIC_MIRROR_DEV_WEB_IMAGE_DIGEST=
MAGIC_MIRROR_DEV_VITE_SUPABASE_URL=
MAGIC_MIRROR_DEV_VITE_SUPABASE_PUBLISHABLE_KEY=
MAGIC_MIRROR_DEV_SUPABASE_SERVICE_ROLE_KEY=
MAGIC_MIRROR_DEV_OPENAI_API_KEY=
MAGIC_MIRROR_DEV_GEMINI_API_KEY=
MAGIC_MIRROR_DEV_DECART_API_KEY=
MAGIC_MIRROR_DEV_EMAIL_DELIVERY_API_KEY=
MAGIC_MIRROR_DEV_EMAIL_FROM_ADDRESS=
MAGIC_MIRROR_DEV_SHOPIFY_AGENT_PROFILE_URL=
