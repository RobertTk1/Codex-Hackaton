{
  "name": "magic-mirror",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "bun scripts/validate-workspaces.ts",
    "validate:workspaces": "bun scripts/validate-workspaces.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun test",
    "check": "bun run validate:workspaces && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
