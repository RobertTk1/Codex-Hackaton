{
  "name": "magic-mirror",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "bun scripts/validate-workspaces.ts",
    "validate:workspaces": "bun scripts/validate-workspaces.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:worker": "bun run --cwd apps/api dev:worker",
    "start:api": "bun run --cwd apps/api start",
    "start:worker": "bun run --cwd apps/api start:worker",
    "build:api": "bun run --cwd apps/api build",
    "build:worker": "bun run --cwd apps/api build:worker",
    "typecheck:api": "bun run --cwd apps/api typecheck",
    "typecheck:contracts": "bun run --cwd packages/contracts typecheck",
    "typecheck": "tsc --noEmit --project tsconfig.json && bun run typecheck:web && bun run typecheck:api && bun run typecheck:contracts",
    "lint": "oxlint --deny-warnings apps packages tests scripts playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "test:db": "bash scripts/test-supabase-policies.sh",
    "validate:deploy": "bun scripts/validate-deploy.ts",
    "deploy:dev": "bun --env-file=.env.digitalocean.dev.local scripts/deploy-development.ts",
    "playwright:install": "playwright install chromium",
    "check": "bun run validate:workspaces && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.14",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
